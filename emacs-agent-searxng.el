(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'url)
(require 'url-util)
(require 'emacs-agent-user-helpers)

(defcustom emacs-agent-searxng-url
  (or (getenv "SEARXNG_URL") "http://172.16.3.65:8180")
  "Base URL of the SearXNG instance, such as \"http://localhost:8080\".
The environment variable SEARXNG_URL wins over the built-in default when it
is set in the Emacs environment."
  :type 'string
  :group 'emacs-agent)

(defcustom emacs-agent-searxng-timeout 15
  "Seconds to wait for a SearXNG response before failing."
  :type 'integer
  :group 'emacs-agent)

(defconst emacs-agent-searxng--url-safe-chars
  (append (string-to-list "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")
          (string-to-list "._~-"))
  "Characters left unencoded in SearXNG query parameters.")

(defun emacs-agent-searxng--clean (value max-length)
  "Collapse whitespace in VALUE, trim and bound it to MAX-LENGTH characters."
  (let ((text (substring-no-properties
                (replace-regexp-in-string "[[:space:]]+" " " (string-trim (or value "")) t))))
    (if (<= (length text) max-length)
        text
      (substring text 0 max-length))))

(defun emacs-agent-searxng--encode (text)
  "Percent-encode the UTF-8 bytes of TEXT for a URL query parameter."
  (mapconcat
   (lambda (ch)
     (if (member ch emacs-agent-searxng--url-safe-chars)
         (string ch)
       (format "%%%02X" ch)))
   (append (encode-coding-string
            (string-trim (substring-no-properties (or text ""))) 'utf-8) nil) ""))

(defun emacs-agent-searxng--endpoint (base)
  "Return the SearXNG /search endpoint for instance BASE."
  (let ((base (replace-regexp-in-string "[?#].*$" "" (string-trim base))))
    (unless (string-match-p "^https?://" base)
      (error "SearXNG URL must use http or https: %s" base))
    (concat (if (string-suffix-p "/" base) base (concat base "/")) "search")))

(cl-defun emacs-agent-searxng--url (query &key categories language)
  "Build the SearXNG JSON search URL for QUERY against `emacs-agent-searxng-url'."
  (let* ((endpoint (emacs-agent-searxng--endpoint emacs-agent-searxng-url))
         (sep (if (string-match-p "?" endpoint) "&" "?"))
         (parts (list "format=json" (concat "q=" (emacs-agent-searxng--encode query)))))
    (when categories
      (push (concat "categories="
                    (emacs-agent-searxng--encode
                     (mapconcat #'substring-no-properties (append categories nil) ",")))
            parts))
    (when language
      (push (concat "language=" (emacs-agent-searxng--encode language))
            parts))
    (concat endpoint sep (mapconcat #'identity (nreverse parts) "&"))))

(defun emacs-agent-searxng--payload (url)
  "Fetch URL synchronously and return the decoded SearXNG JSON payload."
  (unless (fboundp 'url-retrieve-synchronously)
    (error "url-retrieve-synchronously is not available in this Emacs"))
  (let ((buffer (url-retrieve-synchronously url t nil emacs-agent-searxng-timeout))
        (status nil) (header-end nil) (body "") (result nil))
    (unless buffer
      (error "SearXNG request failed: no response from %s" url))
    (with-current-buffer buffer
      (unwind-protect
          (progn
            (setq status
                  (save-excursion
                    (goto-char (point-min))
                    (when (re-search-forward "^HTTP/[0-9.]+ +\\([0-9]+\\)" nil t)
                      (string-to-number (substring-no-properties (match-string 1))))))
            (setq header-end
                  (save-excursion
                    (goto-char (point-min))
                    (forward-line)
                    (let ((end nil))
                      (while (and (not (eobp)) (not end))
                        (if (= (line-beginning-position) (line-end-position))
                            (progn
                              (forward-line)
                              (setq end (point)))
                          (forward-line)))
                      end)))
            (when header-end
              (delete-region (point-min) header-end))
            (setq body (buffer-string))
            (when (and status (>= status 400))
              (error "SearXNG returned HTTP %d: %s"
                     status
                     (substring-no-properties (substring body 0 (min 300 (length body))))))
            (unless enable-multibyte-characters
              (setq body (decode-coding-string body 'utf-8))
              (erase-buffer)
              (set-buffer-multibyte t)
              (insert body))
            (goto-char (point-min))
            (setq result (condition-case err
                             (let ((json-object-type 'alist)
                                   (json-array-type 'vector)
                                   (json-key-type 'symbol))
                               (json-read))
                           (error (error "SearXNG returned invalid JSON: %s"
                                         (error-message-string err))))))
        (kill-buffer buffer)))
    result))

(defun emacs-agent-searxng--field (record key)
  "Return KEY from decoded JSON object RECORD, an alist or a hash table depending
on the Emacs version's json-read default.  Alist keys may be strings or
symbols."
  (if (hash-table-p record)
      (gethash key record)
    (or (assoc-default key record)
        (assoc-default (intern-soft key) record))))

(defun emacs-agent-searxng--format (query payload limit)
  "Render at most LIMIT results from PAYLOAD for QUERY as plain text."
  (let* ((results (and (consp payload) (emacs-agent-searxng--field payload "results")))
         (valid (cl-loop for result across results
                         when (and (consp result)
                                   (stringp (emacs-agent-searxng--field result "url"))
                                   (> (length (emacs-agent-searxng--field result "url")) 0))
                         collect result))
         (lines (cl-loop for result in valid for index from 1 to limit
                         collect (let ((item-url (emacs-agent-searxng--clean (emacs-agent-searxng--field result "url") 2000)))
                                   (let ((title (or (emacs-agent-searxng--clean (emacs-agent-searxng--field result "title") 500)
                                                    item-url))
                                         (snippet (emacs-agent-searxng--clean (emacs-agent-searxng--field result "content") 1500))
                                         (engine (emacs-agent-searxng--clean (emacs-agent-searxng--field result "engine") 100)))
                                     (format "%d. %s\n   %s%s%s"
                                             index title item-url
                                             (if engine (format " (%s)" engine) "")
                                             (if snippet (format "\n   %s" snippet) "")))))))
    (if lines
        (format "SearXNG results for %s:\n\n%s" query (mapconcat #'identity lines "\n\n"))
      (format "No SearXNG results for %s." query))))

(cl-defun emacs-agent-searxng-search (query &key categories language (limit 5))
  "Search the web through the configured SearXNG instance.
QUERY is a nonempty search string.  CATEGORIES is an optional list of
SearXNG categories, such as (\"general\" \"science\").  LANGUAGE is an
optional language code, such as \"en\" or \"ru\".  LIMIT is 1 to 10
maximum results, default 5.

Returns a numbered plain-text list of title, URL (source engine) and
snippet for each result, or a short notice when nothing matched.
Signals an error when the instance is unreachable or answers with an
HTTP error or invalid JSON.  This is a synchronous network request to
`emacs-agent-searxng-url'; it changes no editor state.  Cite the result
URLs in answers built from them."
  (unless (and (stringp query) (> (length (string-trim query)) 0))
    (error "QUERY must be a nonempty string"))
  (unless (and (integerp limit) (<= 1 limit 10))
    (error "LIMIT must be an integer from 1 to 10"))
  (when categories
    (unless (and (proper-list-p categories)
                 (cl-every #'(lambda (category)
                               (and (stringp category)
                                    (> (length (string-trim category)) 0)))
                           categories))
      (error "CATEGORIES must be a list of nonempty strings")))
  (when language
    (unless (and (stringp language) (> (length (string-trim language)) 0))
      (error "LANGUAGE must be a nonempty string")))
  (emacs-agent-searxng--format
   (string-trim query)
   (emacs-agent-searxng--payload
    (emacs-agent-searxng--url query :categories categories :language language))
   limit))

(emacs-agent-register-helper
 'emacs-agent-searxng-search
 :description "Web search through the configured SearXNG instance; use it for current web information or external documentation not available locally."
 :returns "A numbered plain-text list of title, URL (source engine) and snippet for up to LIMIT results, or a one-line notice when nothing matched."
 :constraints "Synchronous network request to emacs-agent-searxng-url (SEARXNG_URL environment variable, default http://172.16.3.65:8180); no editor or file changes. Signals an error when the instance is unreachable or returns invalid JSON. Cite result URLs in answers built from them."
 :example "(emacs-agent-searxng-search \"SearXNG JSON API\" :language \"en\" :limit 3)")

(provide 'emacs-agent-searxng)
